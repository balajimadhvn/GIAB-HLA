manifest {
    name            = 'GIAB-HLA'
    description     = 'HLA class I/II typing from WGS (T1K + OptiType) benchmarked on GIAB HG001 and 1000 Genomes samples'
    author          = 'Balaji Madhavan'
    homePage        = 'https://github.com/balajimadhvn/GIAB-HLA'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

params {
    input        = "${projectDir}/data/reads/samplesheet.csv"
    samples      = "${projectDir}/assets/samples.tsv"
    truth        = "${projectDir}/data/truth/1000G_HLA_types.txt"
    t1k_index    = "${projectDir}/data/ref/t1k_hla"
    outdir       = 'results'
    // existing conda environments (leave null to build them from envs/*.yml)
    t1k_env      = null
    optitype_env = null
    base_env     = null
}

conda.enabled = true

process {
    cpus   = 2
    memory = 3.GB
    shell  = ['/bin/bash', '-euo', 'pipefail']
    withLabel: 't1k'      { conda = { params.t1k_env      ?: "${projectDir}/envs/t1k.yml" } }
    withLabel: 'optitype' { conda = { params.optitype_env ?: "${projectDir}/envs/optitype.yml" }; memory = 4.GB }
    withLabel: 'base'     { conda = { params.base_env     ?: "${projectDir}/environment.yml" }; cpus = 1; memory = 2.GB }
}
// sized for a 16 GB laptop running other software
executor { $local { cpus = 8; memory = '6.5 GB' } }

profiles {
    // GitHub Actions provides micromamba, not conda
    ci { conda.useMicromamba = true }
    test {
        params.input   = "${projectDir}/tests/data/samplesheet.csv"
        params.samples = "${projectDir}/tests/data/samples.tsv"
        params.truth   = "${projectDir}/tests/data/truth.tsv"
        // one allele per 2-field group for HLA-A, -B, -C, -DQB1, -DRB1: small enough to ship, so the test
        // run checks that the pipeline works, not typing accuracy
        params.t1k_index = "${projectDir}/tests/data/t1k_hla"
        params.outdir  = 'results_test'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
